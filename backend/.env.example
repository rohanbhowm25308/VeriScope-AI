# Copy this file to ".env" in the same folder and fill in your key.
# ClaimGuard runs fully offline without Groq -- the AI chatbot and
# "AI Review" second-opinion feature simply stay disabled until you add a key.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model (default shown below).
# Note: Groq deprecated llama-3.3-70b-versatile on 2026-06-17 (returns a 404/400).
# openai/gpt-oss-120b is the current recommended replacement as of Aug 2026.
# If this breaks again in the future, check https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b

# Optional: change the port the Flask server runs on
PORT=5000
