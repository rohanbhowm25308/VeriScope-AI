# Copy this file to ".env" in the same folder and fill in your key.
# VeriScope AI runs fully offline without Groq -- the AI chatbot, "AI
# second opinion", and web-search evidence simply stay disabled until you
# add a key.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model used for chat/AI-review (default shown below).
# Note: Groq deprecated llama-3.3-70b-versatile on 2026-06-17, and deprecated
# groq/compound (the old web-search model) on 2026-09-21. If either of these
# break again in the future, check https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b

# Optional: change the port the Flask server runs on
PORT=5000

# Optional: comma-separated list of allowed origins for CORS, needed when
# the frontend is hosted separately from this backend (e.g. Netlify).
# Defaults to "*" (open) if unset.
ALLOWED_ORIGINS=
